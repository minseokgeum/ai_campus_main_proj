          "subject": {
            "type": "string"
          },
          "amount_text": {
            "type": "string"
          },
          "period_text": {
            "type": "string"
          },
          "evidence_id": {
            "type": "string"
          }
        }
      }
    },
    "price_items": {
      "type": "array",
      "items": {
        "type": "object",
