{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stock_code",
    "evidence",
    "products",
    "brands",
    "materials",
    "customers",
    "competitors",
    "market_shares",
    "contracts",
    "price_items",
    "other_relations",
    "notes"
  ],
  "properties": {
    "stock_code": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "name_en",
          "category",
          "segment",
          "search_terms",
          "end_markets",
          "stage",
          "found_in",
          "evidence_id"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "segment": {
            "type": "string"
          },
          "search_terms": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 5
          },
          "end_markets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "found_in": {
            "type": "string",
            "enum": [
              "표",
              "본문"
            ]
          },
          "evidence_id": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "enum": [
              "판매 중",
              "개발 중",
              "불명"
            ]
          }
        }
      }
    },
    "brands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "name_en",
          "owner_type",
          "product",
          "evidence_id"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "product": {
            "type": "string"
          },
          "evidence_id": {
            "type": "string"
          },
          "owner_type": {
            "type": "string",
            "enum": [
              "자사",
              "고객사(ODM·OEM)",
              "불명"
            ]
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
