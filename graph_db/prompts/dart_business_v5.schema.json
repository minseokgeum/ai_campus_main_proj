          "counterparty",
          "name_en",
          "name_sure",
          "kind",
          "subject",
          "amount_text",
          "period_text",
          "evidence_id"
        ],
        "properties": {
          "counterparty": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "name_sure": {
            "type": "boolean"
