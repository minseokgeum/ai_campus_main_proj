          "name_en",
          "use",
          "suppliers",
          "evidence_id"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "use": {
            "type": "string"
          },
          "suppliers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "name_en",
                "name_sure",
                "note"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "name_en": {
                  "type": "string"
                },
                "name_sure": {
                  "type": "boolean"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "evidence_id": {
            "type": "string"
          }
        }
      }
    },
    "customers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "name_en",
          "name_sure",
          "kind",
          "product",
          "share_text",
          "evidence_id"
