            "type": "string"
          },
          "share_text": {
            "type": "string"
          },
          "evidence_id": {
            "type": "string"
          }
        }
      }
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "name_en",
          "name_sure",
          "product",
          "evidence_id"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "name_sure": {
            "type": "boolean"
          },
          "product": {
            "type": "string"
          },
          "evidence_id": {
            "type": "string"
          }
        }
      }
    },
    "market_shares": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product",
          "market",
          "share_text",
          "evidence_id"
        ],
        "properties": {
          "product": {
            "type": "string"
          },
          "market": {
            "type": "string"
          },
          "share_text": {
            "type": "string"
          },
          "evidence_id": {
            "type": "string"
          }
        }
