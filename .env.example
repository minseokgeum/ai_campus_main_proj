# 프로젝트 루트에 .env로 복사해 값을 채운다. 값(키·비밀번호)은 git에 올리지 않는다.
# 새 키를 쓰는 코드를 추가하면 여기에도 이름을 더한다.

# ── 그래프 DB·뉴스 (graph_db, news_search) ──
OPENDART_API_KEY=            # DART 공시 받기(dart_collector)
KRX_API_KEY=                 # KRX 일별매매정보(dart_targets)
OPENAI_API_KEY=              # LLM 일반 요청·배치(dart_business_extractor, news_extractor, product_llm), 임베딩(news_search 같은 소식 묶기). Codex 구독 실행에는 쓰지 않는다
NEWS_DB_URL=                 # 뉴스 수집 DB(MySQL, 수집기 계정). 예: mysql+pymysql://사용자:비밀번호@호스트:3306/news?charset=utf8mb4
NEWS_DB_READ_URL=            # 뉴스 수집 DB 읽기 전용 계정(news_filter, db_test)
GNEWS_DB_URL=                # 구글 뉴스 검색 결과 DB(PostgreSQL, 오라클 서버). 수집기(news_collect)가 쓰는 계정. 예: postgresql+psycopg://gnews:비밀번호@서버주소:5432/gnews?sslmode=require
GNEWS_DB_READ_URL=           # 같은 DB의 읽기 전용 계정(gnews_read). 팀원·처리 노트북은 이 주소를 GNEWS_DB_URL에 넣어 써도 된다
GNEWS_APP_DB_URL=            # 같은 DB의 서비스(web/) 계정(gnews_app): app 스키마(로그인·보유 종목)는 쓰기, 뉴스 표는 읽기만
NEO4J_URI=                   # 예: bolt://localhost:7687
NEO4J_USER=
NEO4J_PASSWORD=
ALERT_TELEGRAM_TOKEN=        # 알림(수집기, 오래 걸리는 실행). 없으면 화면에만 적는다
ALERT_TELEGRAM_CHAT_ID=
ALERT_DISCORD_WEBHOOK=       # 선택: 수집기 알림을 디스코드로도

# ── 다른 폴더(backtest, stockdata_collection 등)에서 쓰는 키 ──
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
TIINGO_API_TOKEN=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
